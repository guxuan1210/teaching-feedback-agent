# OpenAI-compatible model configuration
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-v4-flash

# Enterprise WeChat intelligent bot (WebSocket long connection)
WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# Optional base URL for the bot's "查看依据" link.
TEACHING_APP_BASE_URL=

# Family image storage (shared by teacher uploads and parent queries)
STUDENT_MEDIA_ROOT=data/student_media
STUDENT_MEDIA_MAX_BYTES=10485760
PENDING_MEDIA_MINUTES=15

# WeCom Customer Service for ordinary WeChat parent contacts (separate from the teacher bot)
WECOM_CUSTOMER_ENABLED=false
WECOM_CUSTOMER_CORP_ID=
WECOM_CUSTOMER_SECRET=
WECOM_CUSTOMER_OPEN_KFID=
WECOM_CUSTOMER_CALLBACK_TOKEN=
WECOM_CUSTOMER_CALLBACK_AES_KEY=
